# Copy this file to .env and adjust values as needed.

# Domain of the docs platform (without scheme).
DOCS_DOMAIN=docs.numerique.gouv.fr

# Local markdown -> yjs converter (impress y-provider).
CONVERT_URL=http://localhost:4444/api/convert/
CONVERT_API_KEY=yprovider-api-key

# Default parent document id under which new docs are created.
DEFAULT_PARENT_ID=uuiduuid-uuid-uuid-uuid-uuiduuiduuid

# LLM excerpt generation — uses any OpenAI-compatible endpoint.
# Defaults to Albert (the French government's LLM gateway). Swap
# OPENAI_BASE_URL + OPENAI_MODEL for OpenAI, a local Ollama, etc.
# Leave OPENAI_API_KEY empty to skip excerpt generation.
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://albert.api.etalab.gouv.fr/v1
OPENAI_MODEL=openai/gpt-oss-120b
EXCERPT_MAX_CHARS=300
