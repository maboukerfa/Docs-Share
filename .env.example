# Copy this file to .env and adjust values as needed.

# Domain of the docs platform (without scheme).
DOCS_DOMAIN=docs.numerique.gouv.fr

# Local markdown -> yjs converter (impress y-provider).
CONVERT_URL=http://localhost:4444/api/convert/
CONVERT_API_KEY=yprovider-api-key

# Default parent document id under which new docs are created.
DEFAULT_PARENT_ID=uuiduuid-uuid-uuid-uuid-uuiduuiduuid
